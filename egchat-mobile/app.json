{
  "expo": {
    "name": "EGCHAT",
    "slug": "egchat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "com.jallzstores.egchat",
      "buildNumber": "137",
      "supportsTablet": false,
      "appleTeamId": "XU6YD7ZJ2K",
      "deploymentTarget": "15.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.egchat.app",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_FULL_SCREEN_INTENT",
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "EGCHAT necesita la camara para fotos de perfil."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "EGCHAT necesita tu ubicacion para servicios de taxi."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00c8a0",
          "defaultChannel": "egchat-messages",
          "sounds": [
            "./assets/notification.wav"
          ]
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "egchat",
    "extra": {
      "apiUrl": "https://egchat-api-xlxj.onrender.com",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6200ec00-54d7-4ef4-a348-56e80a1452f6"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "reddington120"
  }
}
